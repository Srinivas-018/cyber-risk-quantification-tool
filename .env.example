# Groq API
GROQ_API_KEY=your_groq_api_key_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Flask
FLASK_ENV=development
FLASK_PORT=5000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
